# Never commit the real key.
FAL_KEY=

# All paths must be absolute. Defaults point to this project.
SPORTS_CARD_INPUT_DIR=/absolute/path/to/sports-card-mcp/input
SPORTS_CARD_OUTPUT_DIR=/absolute/path/to/sports-card-mcp/output
SPORTS_CARD_ASSETS_DIR=/absolute/path/to/sports-card-mcp/assets
SPORTS_CARD_FONT_PATH=/absolute/path/to/sports-card-mcp/assets/fonts/do-hyeon/DoHyeon-Regular.ttf
SPORTS_CARD_DISPLAY_FONT_PATH=/absolute/path/to/sports-card-mcp/assets/fonts/black-han-sans/BlackHanSans-Regular.ttf
SPORTS_CARD_BODY_FONT_PATH=/absolute/path/to/sports-card-mcp/assets/fonts/do-hyeon/DoHyeon-Regular.ttf
SPORTS_CARD_LATIN_FONT_PATH=/absolute/path/to/sports-card-mcp/assets/fonts/anton/Anton-Regular.ttf

# Replace this with another fal.ai text-to-image endpoint when desired.
FAL_BACKGROUND_MODEL=fal-ai/flux-pro/kontext/text-to-image
# Image-to-image model used for the movie-poster typography plate.
FAL_POSTER_MODEL=fal-ai/flux-pro/kontext
SPORTS_CARD_POSTER_REFERENCE=/absolute/path/to/sports-card-mcp/assets/kim-jaehyun-ai-typography-plate-v2.png
FAL_SEGMENTATION_MODEL=fal-ai/birefnet/v2
FAL_TIMEOUT_MS=120000
FAL_RETRIES=2
MAX_INPUT_BYTES=52428800
MAX_DOWNLOAD_BYTES=41943040
MAX_IMAGE_PIXELS=80000000

# Non-API ChatGPT UI automation. The profile must remain under output.
CHATGPT_UI_PROFILE_DIR=/absolute/path/to/sports-card-mcp/output/.chatgpt-ui-profile
CHATGPT_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHATGPT_UI_TIMEOUT_MS=600000
CHATGPT_UI_RETRIES=2
